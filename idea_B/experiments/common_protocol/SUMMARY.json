  "adapted_skipped": [
    {
      "method_id": "pp_bandit_zeroth_order_reparam_adapted",
      "protocol_label": "adapted-skipped",
      "status": "BLOCKED",
      "official_reproduction": false,
      "reason": "Official PP-bandit core (bandit-icml24.ipynb / official_reproduction/run_official_numerical.py) is a 1-D reparameterization x = y^2 with two-point zeroth-order updates and an inner LearnModel that minimizes Bernoulli KL(x_target || y^2). That procedure queries an uncensored scalar performative-risk function. Idea B environment B2 is a 3-D linear skill model whose performative channel is skill-wise observation censoring, not a Bernoulli mean map, and labels are revealed only under a limited audit budget. A faithful LearnModel+reparameterization port is not feasible on this NumPy protocol without rewriting the paper's 1-D Bernoulli experiment. A two-point ZO-SGD with uniform audits would be a different generic optimizer and must not be relabeled as adapted PP-bandit. Official numerical demo remains in idea_B/baselines/Performative_Bandit_ICML2024/official_reproduction/ (COMPLETE, separate from this leaderboard)."
    }
  ],
